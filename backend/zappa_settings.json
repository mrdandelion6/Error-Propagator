{
    "dev": {
        "aws_region": "us-east-1",
        "django_settings": "backend.settings",
        "slim_handler": true,
        "manage_roles": false,
        "apigateway_enabled": true,
        "aws_environment_variables": {
            "DJANGO_SETTINGS_MODULE": "backend.settings"
        },
        "exclude": [
            "*.pyc",
            "**/*.pyc",
            "tests.py",
            "test.py",
            "**/tests/**",
            "tests/**",
            "concurrent"
        ],
        "exclude_glob": [
            "AVAILABLE-ON-LAMBDA",
            "boto3*",
            "botocore*",
            "pip*",
            "setuptools*",
            "wheel*",
            "awscli*",
            "python-dateutil*",
            
            "DEV-TOOLS",
            "zappa*",
            "troposphere*",
            "kappa*",
            "placebo*"
        ]
    }
}